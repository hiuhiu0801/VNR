# Copy this file to .env.local, then fill in your own keys.
# Do not commit real API keys.

# OpenAI / LLM
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4.1-mini

# OpenAI vector stores.
# Recommended:
# - VITE_AUGUST1945_VECTOR_STORE_ID: textbook excerpt + theory PDF + Session 8/9/10/11.
# - VITE_LSD_TEXTBOOK_VECTOR_STORE_ID: optional wider Lich su Dang textbook OCR store.
# VITE_VECTOR_STORE_ID is kept as a legacy fallback.
VITE_AUGUST1945_VECTOR_STORE_ID=
VITE_LSD_TEXTBOOK_VECTOR_STORE_ID=
VITE_HCM_CHAPTER3_VECTOR_STORE_ID=
VITE_HCM_TEXTBOOK_VECTOR_STORE_ID=
VITE_VECTOR_STORE_ID=
VITE_FILE_SEARCH_MAX_RESULTS=6

# Mapbox GL JS public token for the interactive historical Vietnam map.
# Put the real value in .env.local and restrict the token by domain for production.
VITE_MAPBOX_TOKEN=

# Firebase
VITE_FIREBASE_API_KEY=AIzaSyAwa242kWfl93BPD0WXtMnxvhV0u99wo8o
VITE_FIREBASE_AUTH_DOMAIN=hcm3-f4be8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hcm3-f4be8
VITE_FIREBASE_STORAGE_BUCKET=hcm3-f4be8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=237170981648
VITE_FIREBASE_APP_ID=1:237170981648:web:1db5a55b22d9852f744395
VITE_FIREBASE_MEASUREMENT_ID=G-77LHPFZYF8

# Cloudinary (optional, only for avatar upload)
